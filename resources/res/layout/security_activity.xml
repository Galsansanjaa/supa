<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.uptodown.views.UptodownAppBarLayout
        android:id="@+id/abl_toolbar_positives"
        android:background="@color/background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/UptodownToolbarTheme"
            android:id="@+id/toolbar_positives"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight">
            <com.uptodown.core.view.UptodownTextView
                android:id="@+id/tv_toolbar_title_positives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_left_security_label"
                app:coreTypefaceWeight="medium"
                style="@style/UptodownToolbarStyle"/>
        </androidx.appcompat.widget.Toolbar>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_header_security"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_m"
            app:layout_scrollFlags="enterAlways|scroll">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/rl_turbo_security"
                android:background="@drawable/shape_bg_virustotal_safe"
                android:padding="@dimen/margin_l"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_turbo_icon_security"
                    android:layout_width="@dimen/icon_size_m"
                    android:layout_height="@dimen/icon_size_m"
                    android:contentDescription="@null"
                    android:layout_marginEnd="@dimen/margin_l"
                    app:srcCompat="@drawable/vector_shield_protect"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.uptodown.core.view.UptodownTextView
                        android:textSize="@dimen/font_size_14"
                        android:textColor="@color/text_primary"
                        android:id="@+id/tv_turbo_title_security"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/security_user_no_turbo"/>
                    <com.uptodown.core.view.UptodownTextView
                        android:textColor="@color/accent_color"
                        android:id="@+id/tv_turbo_subtitle_security"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_s"
                        android:text="@string/learn_more"
                        app:coreTypefaceWeight="medium"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_uptodown_protect"
                android:background="@drawable/shape_bg_virustotal_warning_security"
                android:padding="@dimen/margin_l"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m"
                android:layout_marginBottom="@dimen/margin_m"
                android:layout_marginVertical="@dimen/margin_m">
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_l"
                    android:textColor="@color/text_primary"
                    android:id="@+id/tv_uptodown_protect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_s"
                    android:text="@string/label_uptodown_protect"
                    app:coreTypefaceWeight="medium"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_m">
                    <ImageView
                        android:id="@+id/iv_shield"
                        android:layout_width="@dimen/icon_size_m"
                        android:layout_height="@dimen/icon_size_m"
                        android:layout_centerVertical="true"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/vector_vt_report_warning_high"/>
                    <RelativeLayout
                        android:id="@+id/rl_msg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margin_l"
                        android:layout_marginRight="@dimen/margin_l"
                        android:layout_toStartOf="@+id/rl_reload"
                        android:layout_toEndOf="@+id/iv_shield"
                        android:layout_marginHorizontal="@dimen/margin_l">
                        <com.uptodown.core.view.UptodownTextView
                            android:textSize="@dimen/font_size_16"
                            android:textColor="@color/text_primary"
                            android:id="@+id/tv_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_positives_title_security_badge"
                            app:coreTypefaceWeight="medium"/>
                        <com.uptodown.core.view.UptodownTextView
                            android:textSize="@dimen/text_size_m"
                            android:textColor="@color/text_secundary"
                            android:id="@+id/tv_msg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_s"
                            android:text="@string/no_positives_msg_security_badge"
                            android:layout_below="@+id/tv_title"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/rl_reload"
                        android:background="@drawable/ripple_cancel_button"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true">
                        <ImageView
                            android:id="@+id/iv_reload"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_margin="7.5dp"
                            android:contentDescription="@string/refresh_enc"
                            app:srcCompat="@drawable/vector_refresh_protect"/>
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </com.uptodown.views.UptodownAppBarLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_positives"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/rl_free_positives"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_m"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginRight="@dimen/margin_m"
            android:layout_marginHorizontal="@dimen/margin_m">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_positives"
                android:layout_width="@dimen/icon_size_xl"
                android:layout_height="@dimen/icon_size_xl"
                android:contentDescription="@null"
                app:srcCompat="@drawable/vector_myappsupdates_dialog_vt_report"/>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_xl"
                android:gravity="center"
                android:id="@+id/tv_title_free_positives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xl"
                android:text="@string/no_positives_msg_security_badge"
                app:coreTypefaceWeight="medium"/>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_l"
                android:gravity="center"
                android:id="@+id/tv_last_analysis_free_positives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_l"/>
            <com.uptodown.core.view.UptodownTextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_button_analysis_free_positives"
                android:layout_marginTop="@dimen/margin_xl"
                android:text="@string/analyze"
                app:coreTypefaceWeight="medium"
                style="@style/DialogButtonsStyle"/>
        </LinearLayout>
    </LinearLayout>
    <include
        android:layout_gravity="center"
        android:id="@+id/loading_view_security"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/core_loading_view"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
