<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_card_top_download"
    android:background="@drawable/core_ripple_bg_card"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.uptodown.core.view.UptodownTextView
        android:textSize="135sp"
        android:textColor="@color/accent_color"
        android:id="@+id/tv_number_card_top_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/top_downloads_number_margin"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/margin_m"
        android:letterSpacing="-0.08"
        app:coreTypefaceWeight="medium"/>
    <RelativeLayout
        android:id="@+id/rl_card_details_top_download"
        android:layout_width="@dimen/icon_size_xl"
        android:layout_height="wrap_content"
        android:layout_marginStart="-16dp"
        android:layout_toEndOf="@+id/tv_number_card_top_download">
        <ImageView
            android:id="@+id/iv_logo_card_top_download"
            android:layout_width="@dimen/icon_size_xl"
            android:layout_height="@dimen/icon_size_xl"
            android:layout_marginBottom="@dimen/margin_m"
            android:contentDescription="@null"/>
        <com.uptodown.core.view.UptodownTextView
            android:gravity="center_horizontal"
            android:id="@+id/tv_title_card_top_download"
            android:layout_marginTop="@dimen/margin_s"
            android:layout_below="@+id/iv_logo_card_top_download"
            android:layout_centerHorizontal="true"
            android:layout_alignStart="@+id/iv_logo_card_top_download"
            android:layout_alignEnd="@+id/iv_logo_card_top_download"
            app:coreTypefaceWeight="medium"
            style="@style/CardNameTextView"/>
        <com.uptodown.core.view.UptodownTextView
            android:gravity="center_horizontal"
            android:id="@+id/tv_holder_card_top_download"
            android:visibility="invisible"
            android:layout_marginTop="@dimen/margin_s"
            android:lines="5"
            android:layout_below="@+id/iv_logo_card_top_download"
            android:layout_alignStart="@+id/iv_logo_card_top_download"
            android:layout_alignEnd="@+id/iv_logo_card_top_download"
            app:coreTypefaceWeight="medium"
            style="@style/CardTextViewHolder"/>
        <com.uptodown.core.view.UptodownTextView
            android:gravity="center_horizontal"
            android:id="@+id/tv_desc_card_top_download"
            android:layout_below="@+id/tv_title_card_top_download"
            android:layout_alignStart="@+id/iv_logo_card_top_download"
            android:layout_alignEnd="@+id/iv_logo_card_top_download"
            style="@style/CardDescriptionTextView"/>
        <com.uptodown.core.view.UptodownTextView
            android:id="@+id/tv_status_card_top_download"
            android:layout_below="@+id/tv_title_card_top_download"
            app:coreTypefaceWeight="medium"
            style="@style/TextViewAppInfoStatus"/>
        <View
            android:id="@+id/view_bottom_card"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_below="@+id/tv_status_card_top_download"/>
    </RelativeLayout>
</RelativeLayout>
