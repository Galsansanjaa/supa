<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_bg_stroke"
        android:background="@drawable/shape_bg_virustotal_warning_high_bg"
        android:layout_width="4dp"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/rl_vt_warning_header"
        android:layout_alignBottom="@+id/rl_vt_warning_ia"/>
    <RelativeLayout
        android:id="@+id/rl_vt_warning_header"
        android:background="@drawable/shape_bg_virustotal_warning_high_card_top"
        android:padding="@dimen/margin_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp">
        <ImageView
            android:id="@+id/iv_vt_warning"
            android:layout_width="@dimen/icon_size_m"
            android:layout_height="@dimen/icon_size_m"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            app:srcCompat="@drawable/vector_vt_report_warning_high"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_l"
            android:layout_toEndOf="@+id/iv_vt_warning">
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/font_size_16"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_vt_warning_placeholder"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vt_report_warning_title"
                app:coreTypefaceWeight="medium"/>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_m"
                android:textColor="@color/accent_red"
                android:ellipsize="end"
                android:id="@+id/tv_vt_warning_title"
                android:background="@drawable/shape_bg_virustotal_warning_high_risk"
                android:paddingLeft="@dimen/margin_s"
                android:paddingTop="2.5dp"
                android:paddingRight="@dimen/margin_s"
                android:paddingBottom="2.5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:paddingHorizontal="@dimen/margin_s"
                android:paddingVertical="2.5dp"
                app:coreTypefaceWeight="medium"/>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_m"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_vt_warning_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_s"
                app:coreTypefaceWeight="medium"/>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_m"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_vt_warning_latest_scan_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_s"
                android:maxLines="1"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_vt_warning_ia"
        android:background="@drawable/shape_bg_virustotal_warning_high_card_bottom"
        android:padding="@dimen/margin_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_vt_warning_header"
        android:layout_marginStart="3dp">
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/text_primary"
            android:id="@+id/tv_vt_ia_analysis_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/file_level_risk"
            app:coreTypefaceWeight="medium"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:id="@+id/tv_vt_ia_analysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:coreTypefaceWeight="regular"/>
    </RelativeLayout>
    <View
        android:id="@+id/v_separator"
        android:background="@color/vt_separator"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@+id/rl_vt_warning_header"
        android:layout_marginStart="4dp"/>
</RelativeLayout>
