<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_app_info_item"
    android:background="@drawable/core_ripple_bg_card"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_icon_progress_search_app_item"
        android:layout_width="@dimen/icon_size_xl"
        android:layout_height="@dimen/icon_size_xl"
        android:layout_marginTop="@dimen/margin_s"
        android:layout_marginBottom="@dimen/margin_s"
        android:layout_marginVertical="@dimen/margin_s">
        <android.widget.ProgressBar
            android:id="@+id/pb_progress_search_app_item"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="0"
            android:indeterminateDrawable="@drawable/progressbar_circular_indeterminate"
            android:progressDrawable="@drawable/progressbar_circular"
            style="?android:attr/progressBarStyleHorizontal"/>
        <ImageView
            android:id="@+id/iv_icon_search_app_item"
            android:layout_width="@dimen/icon_size_xl"
            android:layout_height="@dimen/icon_size_xl"
            android:adjustViewBounds="true"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            app:srcCompat="@drawable/vector_uptodown_logo_disabled"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/rl_icon_progress_search_app_item">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_m"
            android:layout_marginRight="@dimen/margin_m"
            android:layout_marginHorizontal="@dimen/margin_m">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_name_search_app_item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lines="1"
                    app:coreTypefaceWeight="medium"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_open_source"
                    android:visibility="visible"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:contentDescription="@null"
                    android:layout_marginStart="@dimen/margin_s"
                    app:srcCompat="@drawable/vector_open_source"/>
            </LinearLayout>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_m"
                android:textColor="@color/accent_color"
                android:ellipsize="end"
                android:id="@+id/tv_author_search_app_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_m"
                android:textColor="@color/text_secundary"
                android:ellipsize="end"
                android:id="@+id/tv_desc_search_app_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_download_search_app_item"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xs"
                android:layout_marginEnd="@dimen/margin_s">
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_progress_search_app_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lines="1"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_secundary"
                    android:ellipsize="end"
                    android:id="@+id/tv_verified_search_app_item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_xs"
                    android:text="@string/verified_by"
                    android:maxLines="1"
                    android:lines="1"
                    android:drawablePadding="@dimen/margin_s"
                    app:drawableStartCompat="@drawable/vector_myappsupdates_dialog_vt_report"/>
            </LinearLayout>
        </LinearLayout>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_xs"
            android:textColor="@color/badge_ranking_text"
            android:ellipsize="end"
            android:id="@+id/tv_badge_ranking_search_app_item"
            android:background="@drawable/bg_badge_ranking"
            android:paddingLeft="@dimen/margin_m"
            android:paddingTop="@dimen/margin_s"
            android:paddingRight="@dimen/margin_m"
            android:paddingBottom="@dimen/margin_s"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="150dp"
            android:maxLines="1"
            android:lines="1"
            android:layout_alignParentBottom="true"
            android:textAllCaps="true"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/margin_s"
            android:layout_marginEnd="@dimen/margin_m"
            android:layout_alignParentStart="true"
            android:paddingHorizontal="@dimen/margin_m"
            android:paddingVertical="@dimen/margin_s"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_s"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_action_search_app_item"
            android:background="@drawable/core_ripple_button_accent_color"
            android:padding="@dimen/margin_m"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/option_button_install"
            android:lines="1"
            android:layout_alignParentBottom="true"
            android:textAllCaps="true"
            android:layout_alignParentEnd="true"
            app:coreTypefaceWeight="medium"/>
    </RelativeLayout>
</RelativeLayout>
