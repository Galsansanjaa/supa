<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_m"
        android:textColor="@color/text_primary"
        android:ellipsize="end"
        android:id="@+id/tv_permission_name_item"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_l"
        android:layout_marginRight="@dimen/margin_l"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/margin_l"
        app:coreTypefaceWeight="medium"/>
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_m"
        android:textColor="@color/text_secundary"
        android:ellipsize="end"
        android:id="@+id/tv_permission_item"
        android:background="@drawable/shape_bg_permission_code"
        android:paddingLeft="@dimen/margin_s"
        android:paddingTop="2dp"
        android:paddingRight="@dimen/margin_s"
        android:paddingBottom="2dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_l"
        android:layout_marginRight="@dimen/margin_l"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/margin_l"
        android:paddingHorizontal="@dimen/margin_s"
        android:paddingVertical="2dp"/>
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_m"
        android:textColor="@color/text_secundary"
        android:ellipsize="end"
        android:id="@+id/tv_permission_description_item"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_l"
        android:layout_marginTop="@dimen/margin_s"
        android:layout_marginRight="@dimen/margin_l"
        android:maxLines="3"
        android:layout_marginHorizontal="@dimen/margin_l"/>
    <View
        android:id="@+id/v_permission_divider"
        android:background="@color/bottom_bar_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/margin_m"/>
</LinearLayout>
