<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_bg_dialog"
    android:padding="@dimen/margin_l"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_l"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:id="@+id/tv_title_dialog_exit_from_updates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exit_from_updates_title"
        app:coreTypefaceWeight="medium"/>
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_m"
        android:textColor="@color/cross_cancel_download"
        android:gravity="center"
        android:id="@+id/tv_description_dialog_exit_from_updates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_l"
        android:layout_marginBottom="@dimen/margin_l"
        android:text="@string/exit_from_updates_desc"
        android:layout_marginVertical="@dimen/margin_l"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.uptodown.core.view.UptodownTextView
            android:id="@+id/tv_cancel_exit_from_updates"
            android:background="@drawable/core_ripple_button_accent_color"
            android:text="@string/option_button_cancel"
            android:textAllCaps="true"
            app:coreTypefaceWeight="medium"
            style="@style/DialogButtonsStyle"/>
        <com.uptodown.core.view.UptodownTextView
            android:id="@+id/tv_exit_from_updates"
            android:background="@drawable/core_ripple_button_accent_color"
            android:text="@string/exit"
            android:textAllCaps="true"
            android:layout_marginStart="@dimen/margin_l"
            app:coreTypefaceWeight="medium"
            style="@style/DialogButtonsStyle"/>
    </LinearLayout>
</LinearLayout>
