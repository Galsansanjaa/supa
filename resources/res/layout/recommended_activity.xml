<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.uptodown.views.UptodownAppBarLayout
        android:id="@+id/abl_toolbar_recommended"
        android:background="@color/background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/UptodownToolbarTheme"
            android:id="@+id/toolbar_recommended"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_scrollFlags="enterAlways|scroll"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight">
            <com.uptodown.core.view.UptodownTextView
                android:id="@+id/tv_title_recommended"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_recommended_apps"
                app:coreTypefaceWeight="medium"
                style="@style/UptodownToolbarStyle"/>
        </androidx.appcompat.widget.Toolbar>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="enterAlways|scroll">
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/s_list_state_recommended"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m"
                android:layout_marginBottom="@dimen/margin_m"
                android:checked="false"
                android:thumb="@drawable/selector_slide_thumb_recommended_switch"
                android:layout_marginStart="@dimen/margin_m"
                android:layout_marginVertical="@dimen/margin_m"
                app:track="@drawable/selector_slide_track_recommended_switch"/>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_l"
                android:textColor="@color/text_primary"
                android:id="@+id/tv_list_state_recommended"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_m"
                android:layout_marginRight="@dimen/margin_m"
                android:text="@string/public_list"
                android:layout_alignTop="@+id/s_list_state_recommended"
                android:layout_alignBottom="@+id/s_list_state_recommended"
                android:layout_toEndOf="@+id/s_list_state_recommended"
                android:layout_marginHorizontal="@dimen/margin_m"/>
        </RelativeLayout>
    </com.uptodown.views.UptodownAppBarLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recommended"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/margin_s"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_l"
            android:textColor="@color/text_secundary"
            android:gravity="center"
            android:id="@+id/tv_no_items_recommended"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_m"
            android:text="@string/msg_no_upcoming_releases"/>
        <com.uptodown.core.view.UptodownTextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_explore_recommended"
            android:background="@drawable/core_ripple_button_accent_color"
            android:padding="@dimen/margin_m"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wishlist_explore"
            android:maxLines="1"
            android:textAllCaps="true"/>
    </LinearLayout>
    <include
        android:layout_gravity="center"
        android:id="@+id/loading_view_recommended"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/core_loading_view"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
