<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.uptodown.views.UptodownAppBarLayout
        android:id="@+id/abl_toolbar_notifications_registry"
        android:background="@color/background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/UptodownToolbarTheme"
            android:id="@+id/toolbar_notifications_registry"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_scrollFlags="enterAlways|scroll"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight">
            <com.uptodown.core.view.UptodownTextView
                android:id="@+id/tv_title_notifications_registry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_notification_log"
                app:coreTypefaceWeight="medium"
                style="@style/UptodownToolbarStyle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.uptodown.views.UptodownAppBarLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_notifications_registry"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_xl"
        android:textColor="@color/text_secundary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_no_data_notifications_registry"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:text="@string/no_data_available"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/loading_view_notification_registry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/core_loading_view"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
