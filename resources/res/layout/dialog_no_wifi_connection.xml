<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/core_bg_dialog"
        android:padding="@dimen/margin_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_l"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/tv_title_dialog_no_wifi_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialogo_sin_wifi_titulo"
            app:coreTypefaceWeight="medium"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/text_secundary"
            android:gravity="center"
            android:id="@+id/tv_description_dialog_no_wifi_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginBottom="@dimen/margin_l"
            android:text="@string/dialogo_sin_wifi_mensaje"
            android:layout_marginVertical="@dimen/margin_l"/>
        <com.uptodown.core.view.UptodownCheckBox
            android:textSize="@dimen/text_size_s"
            android:textColor="@color/text_primary"
            android:textColorLink="@color/accent_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/cb_dont_show_again_no_wifi"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:text="@string/dont_show_again"
            android:paddingStart="@dimen/margin_s"
            android:paddingEnd="14dp"
            android:buttonTint="@color/accent_color"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.uptodown.core.view.UptodownTextView
                android:id="@+id/tv_settings_dialog_no_wifi_connection"
                android:background="@drawable/ripple_light_grey"
                android:text="@string/settings"
                android:layout_marginEnd="@dimen/margin_l"
                app:coreTypefaceWeight="medium"
                style="@style/DialogButtonsStyle"/>
            <com.uptodown.core.view.UptodownTextView
                android:textColor="@color/accent_color"
                android:id="@+id/tv_cancel_dialog_no_wifi_connection"
                android:background="@drawable/ripple_open_button"
                android:layout_width="80dp"
                android:text="@string/option_button_cancel"
                android:layout_marginEnd="@dimen/margin_m"
                android:layout_toStartOf="@+id/tv_ok_dialog_no_wifi_connection"
                app:coreTypefaceWeight="medium"
                style="@style/DialogButtonsStyle"/>
            <com.uptodown.core.view.UptodownTextView
                android:id="@+id/tv_ok_dialog_no_wifi_connection"
                android:layout_width="80dp"
                android:text="@string/ok"
                android:layout_alignParentEnd="true"
                app:coreTypefaceWeight="medium"
                style="@style/DialogButtonsStyle"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
