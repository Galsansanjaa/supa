<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.uptodown.views.UptodownAppBarLayout
        android:id="@+id/abl_toolbar_aida"
        android:background="@color/background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/UptodownToolbarTheme"
            android:id="@+id/toolbar_aida"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_scrollFlags="enterAlways|scroll"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight">
            <com.uptodown.core.view.UptodownTextView
                android:id="@+id/tv_toolbar_title_app_installed_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_instaled_details"
                app:coreTypefaceWeight="medium"
                style="@style/UptodownToolbarStyle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.uptodown.views.UptodownAppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_aida"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_info_aida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_m"
            android:layout_marginRight="@dimen/margin_m"
            android:layout_marginHorizontal="@dimen/margin_m">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_m">
                <RelativeLayout
                    android:id="@+id/rl_logo_aida"
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:layout_marginTop="@dimen/margin_m"
                    android:layout_marginEnd="@dimen/margin_m">
                    <ProgressBar
                        android:id="@+id/pb_progress_aida"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        android:progress="0"
                        android:indeterminateDrawable="@drawable/progressbar_circular_indeterminate"
                        android:progressDrawable="@drawable/progressbar_circular"
                        style="?android:attr/progressBarStyleHorizontal"/>
                    <ImageView
                        android:id="@+id/iv_logo_aida"
                        android:layout_width="@dimen/icon_size_xl"
                        android:layout_height="@dimen/icon_size_xl"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/vector_uptodown_logo_disabled"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_toEndOf="@+id/rl_logo_aida">
                    <com.uptodown.core.view.UptodownTextView
                        android:textSize="@dimen/text_size_xl"
                        android:textColor="@color/text_primary"
                        android:ellipsize="end"
                        android:id="@+id/tv_app_name_aida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_m"
                        android:maxLines="3"
                        app:coreTypefaceWeight="medium"/>
                    <com.uptodown.core.view.UptodownTextView
                        android:textSize="@dimen/text_size_m"
                        android:textColor="@color/accent_color"
                        android:ellipsize="end"
                        android:id="@+id/tv_version_aida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_download_info_aida"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp">
                        <com.uptodown.core.view.UptodownTextView
                            android:textSize="@dimen/text_size_m"
                            android:textColor="@color/text_primary"
                            android:ellipsize="end"
                            android:id="@+id/tv_progress_aida"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="1dp"
                            android:maxLines="1"
                            android:lines="1"
                            android:layout_marginEnd="@dimen/margin_s"/>
                        <com.uptodown.core.view.UptodownTextView
                            android:textSize="@dimen/text_size_m"
                            android:textColor="@color/text_secundary"
                            android:ellipsize="end"
                            android:id="@+id/tv_verified_aida"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_xs"
                            android:text="@string/verified_by"
                            android:maxLines="1"
                            android:lines="1"
                            android:drawablePadding="@dimen/margin_s"
                            android:layout_marginEnd="@dimen/margin_s"
                            app:drawableStartCompat="@drawable/vector_myappsupdates_dialog_vt_report"/>
                    </LinearLayout>
                    <com.uptodown.core.view.UptodownTextView
                        android:textSize="@dimen/text_size_xs"
                        android:textColor="@color/grey_70"
                        android:ellipsize="end"
                        android:id="@+id/tv_type_aida"
                        android:background="@drawable/bg_status_download_installed"
                        android:paddingLeft="@dimen/margin_m"
                        android:paddingTop="@dimen/margin_s"
                        android:paddingRight="@dimen/margin_m"
                        android:paddingBottom="@dimen/margin_s"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_s"
                        android:textAllCaps="true"
                        android:layout_marginEnd="@dimen/margin_m"
                        android:paddingHorizontal="@dimen/margin_m"
                        android:paddingVertical="@dimen/margin_s"/>
                    <com.uptodown.core.view.UptodownTextView
                        android:textSize="@dimen/text_size_xs"
                        android:textColor="@color/grey_70"
                        android:ellipsize="end"
                        android:id="@+id/tv_status_aida"
                        android:background="@drawable/bg_status_download_installed"
                        android:paddingLeft="@dimen/margin_m"
                        android:paddingTop="@dimen/margin_s"
                        android:paddingRight="@dimen/margin_m"
                        android:paddingBottom="@dimen/margin_s"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_s"
                        android:text="@string/dark_mode_disabled"
                        android:textAllCaps="true"
                        android:layout_marginEnd="@dimen/margin_m"
                        android:paddingHorizontal="@dimen/margin_m"
                        android:paddingVertical="@dimen/margin_s"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/ll_buttons_container_aida"
                android:layout_width="match_parent"
                android:layout_height="@dimen/action_main_button_height"
                android:layout_marginTop="@dimen/margin_m"
                android:layout_marginBottom="@dimen/margin_m"
                android:layout_marginVertical="@dimen/margin_m">
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_l"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_open_aida"
                    android:background="@drawable/core_ripple_button_accent_color"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/open"
                    android:textAllCaps="true"
                    android:layout_toStartOf="@+id/iv_uninstall_aida"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="2sp"
                    android:autoSizeMinTextSize="@dimen/text_size_xs"
                    android:autoSizeMaxTextSize="@dimen/text_size_l"
                    app:coreTypefaceWeight="medium"/>
                <ImageView
                    android:id="@+id/iv_uninstall_aida"
                    android:background="@drawable/ripple_open_button"
                    android:padding="12dp"
                    android:layout_width="@dimen/icon_size_m"
                    android:layout_height="@dimen/icon_size_m"
                    android:contentDescription="@null"
                    android:layout_marginStart="@dimen/margin_m"
                    android:layout_alignParentEnd="true"
                    app:srcCompat="@drawable/vector_uninstall"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_l"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_update_aida"
                    android:background="@drawable/core_ripple_button_accent_color"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/action_main_button_height"
                    android:text="@string/updates_button_update_app"
                    android:textAllCaps="true"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="2sp"
                    android:autoSizeMinTextSize="@dimen/text_size_xs"
                    android:autoSizeMaxTextSize="@dimen/text_size_l"
                    app:coreTypefaceWeight="medium"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_l"
                    android:textColor="@color/accent_color"
                    android:gravity="center"
                    android:id="@+id/tv_cancel_aida"
                    android:background="@drawable/ripple_stroke_blue_primary"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/action_main_button_height"
                    android:text="@string/option_button_cancel"
                    android:textAllCaps="true"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="2sp"
                    android:autoSizeMinTextSize="@dimen/text_size_xs"
                    android:autoSizeMaxTextSize="@dimen/text_size_l"
                    app:coreTypefaceWeight="medium"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/rl_status_loading_aida"
                    android:background="@drawable/shape_stroke_blue_primary"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/action_main_button_height"
                    android:elevation="@dimen/button_elevation">
                    <ProgressBar
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_m"
                        android:layout_marginBottom="@dimen/margin_m"
                        android:layout_centerInParent="true"
                        android:layout_marginVertical="@dimen/margin_m"
                        style="@style/CoreProgressBarLoadingContent"/>
                </RelativeLayout>
            </LinearLayout>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_l"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_app_info_label_aida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_l"
                android:text="@string/action_app_details_settings"
                android:maxLines="1"
                android:lines="1"
                app:coreTypefaceWeight="medium"/>
            <RelativeLayout
                android:id="@+id/rl_packagename_aida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m">
                <ImageView
                    android:id="@+id/iv_packagename_aida"
                    android:layout_width="@dimen/icon_size_m"
                    android:layout_height="@dimen/icon_size_m"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:layout_marginEnd="@dimen/margin_m"
                    app:srcCompat="@drawable/vector_more_info_packagename"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:gravity="bottom"
                    android:id="@+id/tv_packagename_label_aida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/version_details_packagename_label"
                    android:maxLines="1"
                    android:lines="1"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toEndOf="@+id/iv_packagename_aida"
                    app:coreTypefaceWeight="medium"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_packagename_aida"
                    android:paddingBottom="@dimen/margin_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_below="@+id/tv_packagename_label_aida"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toEndOf="@+id/iv_packagename_aida"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_version_aida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m">
                <ImageView
                    android:id="@+id/iv_version_aida"
                    android:layout_width="@dimen/icon_size_m"
                    android:layout_height="@dimen/icon_size_m"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:layout_marginEnd="@dimen/margin_m"
                    app:srcCompat="@drawable/vector_more_info_requirements"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:gravity="bottom"
                    android:id="@+id/tv_versioncode_label_aida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_info_version_label"
                    android:maxLines="1"
                    android:lines="1"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toEndOf="@+id/iv_version_aida"
                    app:coreTypefaceWeight="medium"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_versioncode_aida"
                    android:paddingBottom="@dimen/margin_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_below="@+id/tv_versioncode_label_aida"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toEndOf="@+id/iv_version_aida"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_requirements_aida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m"
                android:animateLayoutChanges="true">
                <ImageView
                    android:id="@+id/iv_req_aida"
                    android:layout_width="@dimen/icon_size_m"
                    android:layout_height="@dimen/icon_size_m"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:layout_marginEnd="@dimen/margin_m"
                    app:srcCompat="@drawable/vector_more_info_requirements"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:gravity="bottom"
                    android:id="@+id/tv_req_label_aida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_info_requires"
                    android:maxLines="1"
                    android:lines="1"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toEndOf="@+id/iv_req_aida"
                    app:coreTypefaceWeight="medium"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_req_aida"
                    android:paddingBottom="@dimen/margin_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_below="@+id/tv_req_label_aida"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toEndOf="@+id/iv_req_aida"/>
                <View
                    android:id="@+id/v_req_aida"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_sha256_aida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m"
                android:animateLayoutChanges="true">
                <ImageView
                    android:id="@+id/iv_sha256_aida"
                    android:layout_width="@dimen/icon_size_m"
                    android:layout_height="@dimen/icon_size_m"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:layout_marginEnd="@dimen/margin_m"
                    app:srcCompat="@drawable/vector_more_info_sha256"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:gravity="bottom"
                    android:id="@+id/tv_sha256_label_aida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_info_label_sha256"
                    android:maxLines="1"
                    android:lines="1"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toStartOf="@+id/tv_view_files_aida"
                    android:layout_toEndOf="@+id/iv_sha256_aida"
                    app:coreTypefaceWeight="medium"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_sha256_aida"
                    android:paddingBottom="@dimen/margin_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_below="@+id/tv_sha256_label_aida"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toStartOf="@+id/tv_view_files_aida"
                    android:layout_toEndOf="@+id/iv_sha256_aida"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_s"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_view_files_aida"
                    android:background="@drawable/core_ripple_button_accent_color"
                    android:padding="@dimen/margin_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="120dp"
                    android:text="@string/view_files"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:layout_marginEnd="@dimen/margin_s"
                    android:layout_alignParentEnd="true"
                    app:coreTypefaceWeight="medium"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_author_aida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m">
                <ImageView
                    android:id="@+id/iv_author_aida"
                    android:layout_width="@dimen/icon_size_m"
                    android:layout_height="@dimen/icon_size_m"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:layout_marginEnd="@dimen/margin_m"
                    app:srcCompat="@drawable/vector_more_info_developer"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:gravity="bottom"
                    android:id="@+id/tv_author_label_aida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_info_author"
                    android:maxLines="1"
                    android:lines="1"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toEndOf="@+id/iv_author_aida"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_author_aida"
                    android:paddingBottom="@dimen/margin_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_below="@+id/tv_author_label_aida"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toEndOf="@+id/iv_author_aida"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_date_aida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m">
                <ImageView
                    android:id="@+id/iv_date_aida"
                    android:layout_width="@dimen/icon_size_m"
                    android:layout_height="@dimen/icon_size_m"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:layout_marginEnd="@dimen/margin_m"
                    app:srcCompat="@drawable/vector_more_info_date"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:gravity="bottom"
                    android:id="@+id/tv_date_label_aida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_installed_first_installed"
                    android:maxLines="1"
                    android:lines="1"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toEndOf="@+id/iv_date_aida"
                    app:coreTypefaceWeight="medium"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_date_aida"
                    android:paddingBottom="@dimen/margin_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_below="@+id/tv_date_label_aida"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toEndOf="@+id/iv_date_aida"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_last_updated_aida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m">
                <ImageView
                    android:id="@+id/iv_last_updated_aida"
                    android:layout_width="@dimen/icon_size_m"
                    android:layout_height="@dimen/icon_size_m"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:layout_marginEnd="@dimen/margin_m"
                    app:srcCompat="@drawable/vector_more_info_date"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:gravity="bottom"
                    android:id="@+id/tv_last_updated_label_aida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/last_updated"
                    android:maxLines="1"
                    android:lines="1"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toEndOf="@+id/iv_last_updated_aida"
                    app:coreTypefaceWeight="medium"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_last_updated_aida"
                    android:paddingBottom="@dimen/margin_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_below="@+id/tv_last_updated_label_aida"
                    android:layout_marginEnd="@dimen/margin_m"
                    android:layout_toEndOf="@+id/iv_last_updated_aida"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_update_installer_aida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m">
                <ImageView
                    android:id="@+id/iv_update_installer_aida"
                    android:layout_width="@dimen/icon_size_m"
                    android:layout_height="@dimen/icon_size_m"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:layout_marginEnd="@dimen/margin_m"
