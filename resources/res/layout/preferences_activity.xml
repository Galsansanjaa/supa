<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_app_info_item"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.uptodown.views.UptodownAppBarLayout
        android:id="@+id/abl_toolbar_preferences"
        android:background="@color/background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/UptodownToolbarTheme"
            android:id="@+id/toolbar_preferences"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_scrollFlags="enterAlways|scroll"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight">
            <com.uptodown.core.view.UptodownTextView
                android:id="@+id/tv_toolbar_title_preferences"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                app:coreTypefaceWeight="medium"
                style="@style/UptodownToolbarStyle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.uptodown.views.UptodownAppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_preferences_list"
            android:paddingBottom="@dimen/margin_l"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">
            <include
                android:id="@+id/language_setting"
                layout="@layout/preference_item"/>
            <include
                android:id="@+id/updates_category"
                layout="@layout/preference_category"/>
            <include
                android:id="@+id/updates_setting"
                layout="@layout/preference_switch"/>
            <include
                android:id="@+id/file_management_category"
                layout="@layout/preference_category"/>
            <include
                android:id="@+id/installable_files_notification_setting"
                layout="@layout/preference_switch"/>
            <include
                android:id="@+id/root_category"
                layout="@layout/preference_category"/>
            <include
                android:id="@+id/auto_update_root_switch_setting"
                layout="@layout/preference_switch"/>
            <include
                android:id="@+id/quick_install_root_switch_setting"
                layout="@layout/preference_switch"/>
            <include
                android:id="@+id/performance_category"
                layout="@layout/preference_category"/>
            <include
                android:id="@+id/mobile_data_usage_setting"
                layout="@layout/preference_list"/>
            <include
                android:id="@+id/notifications_category"
                layout="@layout/preference_category"/>
            <include
                android:id="@+id/show_notifications_setting"
                layout="@layout/preference_switch"/>
            <include
                android:id="@+id/updates_notification_setting"
                layout="@layout/preference_list"/>
            <include
                android:id="@+id/downloads_notification_setting"
                layout="@layout/preference_switch"/>
            <include
                android:id="@+id/installations_notification_setting"
                layout="@layout/preference_switch"/>
            <include
                android:id="@+id/privacy_and_policy_category"
                layout="@layout/preference_category"/>
            <include
                android:id="@+id/age_verification_setting"
                layout="@layout/preference_list"/>
            <include
                android:id="@+id/privacy_setting"
                layout="@layout/preference_item"/>
            <include
                android:id="@+id/advanced_setting"
                layout="@layout/preference_item"/>
            <include
                android:id="@+id/more_info_category"
                layout="@layout/preference_category"/>
            <include
                android:id="@+id/tos_setting"
                layout="@layout/preference_item"/>
            <include
                android:id="@+id/support_setting"
                layout="@layout/preference_item"/>
            <include
                android:id="@+id/ads_setting"
                layout="@layout/preference_item"/>
            <include
                android:id="@+id/about_app_setting"
                layout="@layout/preference_item"/>
            <include
                android:id="@+id/about_uptodown_setting"
                layout="@layout/preference_item"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
