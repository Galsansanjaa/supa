<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.uptodown.views.UptodownAppBarLayout
        android:id="@+id/abl_toolbar_rollback"
        android:background="@color/background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_rollback"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_scrollFlags="enterAlways|scroll">
            <com.uptodown.core.view.UptodownTextView
                android:id="@+id/tv_title_rollback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rollback_title"
                app:coreTypefaceWeight="medium"
                style="@style/UptodownToolbarStyle"/>
        </androidx.appcompat.widget.Toolbar>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_l"
            android:textColor="@color/text_primary"
            android:id="@+id/tv_subtitle_rollback"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_m"
            android:layout_marginRight="@dimen/margin_m"
            android:text="@string/rollback_subtitle"
            android:layout_marginHorizontal="@dimen/margin_m"
            app:layout_scrollFlags="enterAlways|scroll"/>
    </com.uptodown.views.UptodownAppBarLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/margin_m"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_l"
            android:textColor="@color/text_secundary"
            android:gravity="center"
            android:id="@+id/tv_no_items"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="@string/msg_checking_device_rollback"/>
        <com.uptodown.core.view.UptodownTextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_gdpr_button_rollback"
            android:background="@drawable/core_ripple_button_accent_color"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="@string/gdpr_set_up"
            android:textAllCaps="true"/>
    </LinearLayout>
    <include
        android:layout_gravity="center"
        android:id="@+id/loading_view_rollback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/core_loading_view"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
