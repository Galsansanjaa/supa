<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_app_info_top_by_cat_item"
    android:background="@drawable/core_ripple_bg_card"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_m">
    <RelativeLayout
        android:id="@+id/rl_logo_app_info_top_by_cat_item"
        android:layout_width="@dimen/icon_size_xl"
        android:layout_height="@dimen/icon_size_xl"
        android:layout_marginBottom="@dimen/margin_m"
        android:layout_marginEnd="@dimen/margin_m">
        <ProgressBar
            android:id="@+id/pb_progress_app_info_top_by_cat_item"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="0"
            android:indeterminateDrawable="@drawable/progressbar_circular_indeterminate"
            android:progressDrawable="@drawable/progressbar_circular"
            style="?android:attr/progressBarStyleHorizontal"/>
        <ImageView
            android:id="@+id/iv_logo_app_info_top_by_cat_item"
            android:layout_width="@dimen/icon_size_xl"
            android:layout_height="@dimen/icon_size_xl"
            android:contentDescription="@null"
            app:srcCompat="@drawable/shape_bg_placeholder"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/rl_logo_app_info_top_by_cat_item">
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_xl"
            android:textColor="@color/accent_color"
            android:id="@+id/tv_number_app_info_top_by_cat_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_alignBaseline="@+id/rl_container_app_name"
            app:coreTypefaceWeight="medium"/>
        <RelativeLayout
            android:id="@+id/rl_container_app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/rl_container_tags"
            android:layout_toEndOf="@+id/tv_number_app_info_top_by_cat_item">
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_l"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_name_app_info_top_by_cat_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="@dimen/margin_s"
                app:coreTypefaceWeight="medium"/>
            <ImageView
                android:id="@+id/iv_badge_open_source"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_centerVertical="true"
                android:contentDescription="@string/open_source"
                android:layout_marginStart="@dimen/margin_s"
                android:layout_toEndOf="@+id/tv_name_app_info_top_by_cat_item"
                app:srcCompat="@drawable/vector_open_source"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_container_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/iv_alternative_compare"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/content_description_compare"
                app:srcCompat="@drawable/vector_compare"/>
        </RelativeLayout>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/text_secundary"
            android:ellipsize="end"
            android:id="@+id/tv_desc_app_info_top_by_cat_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_above="@+id/tv_action_app_info_top_by_cat_info_item"
            android:layout_below="@+id/rl_container_app_name"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_info_app_info_top_by_cat_info_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_m"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/margin_m"
            android:layout_toStartOf="@+id/tv_action_app_info_top_by_cat_info_item"
            android:layout_alignParentStart="true">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_rating_app_info_top_by_cat_info_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_s">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@string/your_valoration"
                    app:srcCompat="@drawable/vector_star_on"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/details_text_color"
                    android:id="@+id/tv_rating_app_info_top_by_cat_info_item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin_s"
                    android:layout_marginRight="@dimen/margin_s"
                    android:maxLines="1"
                    android:layout_marginHorizontal="@dimen/margin_s"/>
                <View
                    android:background="@color/grey_70"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_m"
                android:textColor="@color/details_text_color"
                android:ellipsize="end"
                android:id="@+id/tv_downloads_counter_app_info_top_by_cat_info_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_s"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_action_app_info_top_by_cat_info_item"
            android:background="@drawable/core_ripple_button_accent_color"
            android:padding="@dimen/margin_m"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/option_button_install"
            android:lines="1"
            android:layout_alignParentBottom="true"
            android:textAllCaps="true"
            android:layout_alignParentEnd="true"
            app:coreTypefaceWeight="medium"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_download_app_info_top_by_cat_info_item"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xs"
            android:layout_below="@+id/rl_container_app_name"
            android:layout_marginEnd="@dimen/margin_s">
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_m"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_progress_app_info_top_by_cat_info_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:lines="1"/>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_m"
                android:textColor="@color/text_secundary"
                android:ellipsize="end"
                android:id="@+id/tv_verified_app_info_top_by_cat_info_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xs"
                android:text="@string/verified_by"
                android:maxLines="1"
                android:lines="1"
                android:drawablePadding="@dimen/margin_s"
                app:drawableStartCompat="@drawable/vector_myappsupdates_dialog_vt_report"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
