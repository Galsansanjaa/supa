<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_bg_dialog"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_l"
        android:textColor="@color/text_primary"
        android:id="@+id/tv_msg_installed_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_m"
        android:text="@string/core_msg_version_already_installed"
        app:coreTypefaceWeight="regular"/>
    <com.uptodown.core.view.UptodownCheckBox
        android:textSize="@dimen/text_size_m"
        android:textColor="@color/text_secundary"
        android:id="@+id/cb_not_again_installed_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/core_no_ask_again"
        android:buttonTint="@color/accent_color"
        app:coreTypefaceWeight="regular"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">
        <com.uptodown.core.view.UptodownTextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_cancel"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/option_button_cancel"
            app:coreTypefaceWeight="medium"
            style="@style/DialogButtonsStyle"/>
        <com.uptodown.core.view.UptodownTextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_install"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/option_button_install"
            android:layout_marginStart="@dimen/margin_m"
            app:coreTypefaceWeight="medium"
            style="@style/DialogButtonsStyle"/>
    </LinearLayout>
</LinearLayout>
