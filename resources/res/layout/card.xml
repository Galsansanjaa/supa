<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_card"
    android:background="@drawable/core_ripple_bg_card"
    android:focusable="true"
    android:layout_width="100dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_logo_card"
        android:layout_width="@dimen/icon_size_xl"
        android:layout_height="@dimen/icon_size_xl"
        android:layout_marginBottom="@dimen/margin_m"
        android:contentDescription="@null"
        app:srcCompat="@drawable/shape_bg_placeholder"/>
    <com.uptodown.core.view.UptodownTextView
        android:gravity="center_horizontal"
        android:id="@+id/tv_title_card"
        android:layout_marginTop="@dimen/margin_s"
        android:layout_below="@+id/iv_logo_card"
        android:layout_centerHorizontal="true"
        app:coreTypefaceWeight="medium"
        style="@style/CardNameTextView"/>
    <com.uptodown.core.view.UptodownTextView
        android:gravity="center_vertical"
        android:id="@+id/tv_holder_card"
        android:visibility="invisible"
        android:layout_marginTop="@dimen/margin_s"
        android:lines="5"
        android:layout_below="@+id/iv_logo_card"
        app:coreTypefaceWeight="medium"
        style="@style/CardTextViewHolder"/>
    <com.uptodown.core.view.UptodownTextView
        android:gravity="center"
        android:id="@+id/tv_desc_card"
        android:layout_below="@+id/tv_title_card"
        android:layout_centerHorizontal="true"
        style="@style/CardDescriptionTextView"/>
    <com.uptodown.core.view.UptodownTextView
        android:id="@+id/tv_status_card"
        android:layout_below="@+id/tv_title_card"
        app:coreTypefaceWeight="medium"
        style="@style/TextViewAppInfoStatus"/>
    <View
        android:id="@+id/view_bottom_card"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_below="@+id/tv_status_card"/>
</RelativeLayout>
