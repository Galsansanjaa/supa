<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_installer_activity"
    android:background="@drawable/core_bg_instaler_activity"
    android:padding="@dimen/margin_l"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_l">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_logo_app_detail"
            android:layout_width="@dimen/icon_size_l"
            android:layout_height="@dimen/icon_size_l"
            android:layout_marginLeft="@dimen/margin_m"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_marginRight="@dimen/margin_m"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="@dimen/margin_m">
            <ProgressBar
                android:id="@+id/pb_bg_installer_activity"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progress="100"
                android:progressDrawable="@drawable/core_bg_progressbar_circular"
                style="?android:attr/progressBarStyleHorizontal"/>
            <ProgressBar
                android:id="@+id/pb_installer_activity"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progress="0"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/core_progressbar_circular_indeterminate"
                android:progressDrawable="@drawable/core_progressbar_circular"
                style="?android:attr/progressBarStyleHorizontal"/>
            <ImageView
                android:id="@+id/iv_logo_apk_installer_activity"
                android:padding="25dp"
                android:layout_width="@dimen/icon_size_l"
                android:layout_height="@dimen/icon_size_l"
                android:contentDescription="@null"
                app:srcCompat="@drawable/core_vector_apk"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/iv_hide_installer_activity"
            android:background="@drawable/core_ripple_bg_card"
            android:padding="6dp"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/core_vector_minimize"
            android:contentDescription="@null"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/xapk_filename_size"
        android:textColor="@color/text_primary"
        android:ellipsize="middle"
        android:gravity="center"
        android:id="@+id/tv_app_name_installer_activity"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:singleLine="true"
        app:coreTypefaceWeight="medium"/>
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/xapk_filename_size"
        android:textColor="@color/text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_msg_installer_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:maxLines="1"
        android:lines="1"
        app:coreTypefaceWeight="regular"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_info_installer_activity"
        android:background="@drawable/core_shape_bg_info_installer"
        android:padding="@dimen/margin_m"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m">
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/xapk_filename_size"
            android:textColor="@color/text_secundary"
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/tv_file_name_label_installer_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/core_compress_dialog_file_name"
            android:singleLine="true"
            app:coreTypefaceWeight="regular"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/xapk_filename_size"
            android:textColor="@color/text_primary"
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/tv_file_name_installer_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:coreTypefaceWeight="medium"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/xapk_filename_size"
            android:textColor="@color/text_secundary"
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/tv_size_label_installer_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:text="@string/size_label"
            android:singleLine="true"
            app:coreTypefaceWeight="regular"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/xapk_filename_size"
            android:textColor="@color/text_primary"
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/tv_size_installer_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:coreTypefaceWeight="medium"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/xapk_filename_size"
            android:textColor="@color/text_secundary"
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/tv_version_label_installer_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:text="@string/version_label"
            android:singleLine="true"
            app:coreTypefaceWeight="regular"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/xapk_filename_size"
            android:textColor="@color/text_primary"
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/tv_version_installer_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:coreTypefaceWeight="medium"/>
    </LinearLayout>
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/xapk_filename_size"
        android:textColor="@color/text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_msg_info_installer_activity"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:maxLines="4"
        app:coreTypefaceWeight="regular"/>
    <include layout="@layout/core_ll_new_features"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_l"
        android:layout_marginTop="@dimen/margin_l"
        android:layout_marginRight="@dimen/margin_l"
        android:layout_marginHorizontal="@dimen/margin_l">
        <com.uptodown.core.view.UptodownTextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_cancel_installer_activity"
            android:background="@drawable/core_ripple_button_accent_color"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="90dp"
            android:layout_height="35dp"
            android:text="@string/option_button_cancel"
            android:textAllCaps="true"
            app:coreTypefaceWeight="medium"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_install_installer_activity"
            android:background="@drawable/core_ripple_button_accent_color"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="90dp"
            android:layout_height="35dp"
            android:text="@string/option_button_install"
            android:textAllCaps="true"
            android:layout_marginStart="@dimen/margin_l"
            app:coreTypefaceWeight="medium"/>
    </LinearLayout>
</LinearLayout>
