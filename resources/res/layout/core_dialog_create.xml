<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_bg_dialog"
    android:padding="@dimen/margin_l"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_l"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:id="@+id/tv_dialog_title_create"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_m"
        android:text="@string/core_action_create"
        app:coreTypefaceWeight="medium"/>
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_m"
        android:textColor="@color/text_secundary"
        android:gravity="center"
        android:id="@+id/tv_dialog_file_name_create"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_l"
        android:text="@string/core_create_dialog_title"
        app:coreTypefaceWeight="regular"/>
    <com.uptodown.core.view.UptodownEditText
        android:textSize="@dimen/text_size_m"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/grey_70"
        android:id="@+id/et_dialog_file_name_create"
        android:background="@drawable/core_bg_search_view"
        android:padding="@dimen/margin_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:hint="@string/core_file_name_hint"
        android:inputType="text"
        android:textCursorDrawable="@null"
        android:layout_marginEnd="@dimen/margin_m"
        android:autofillHints="name"
        app:coreTypefaceWeight="regular"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_l"
        android:paddingVertical="8dp">
        <com.uptodown.core.view.UptodownTextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_cancel_option_create"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/option_button_cancel"
            app:coreTypefaceWeight="medium"
            style="@style/DialogButtonsStyle"/>
        <com.uptodown.core.view.UptodownTextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_accept_option_create"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/core_action_create"
            android:layout_marginStart="10dp"
            app:coreTypefaceWeight="medium"
            style="@style/DialogButtonsStyle"/>
    </LinearLayout>
</LinearLayout>
