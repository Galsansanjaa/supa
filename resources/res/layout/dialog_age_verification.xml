<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/core_bg_dialog"
        android:padding="@dimen/margin_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_l"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/tv_title_dialog_age_verification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/age_verification_title"
            app:coreTypefaceWeight="medium"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/cross_cancel_download"
            android:gravity="center"
            android:id="@+id/tv_msg_dialog_age_verification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginBottom="@dimen/margin_l"
            android:text="@string/age_verification_desc"
            android:layout_marginVertical="@dimen/margin_l"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/cross_cancel_download"
            android:gravity="center"
            android:id="@+id/tv_input_title_age_verification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/age_verification_input_title"/>
        <com.uptodown.core.view.UptodownEditText
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/grey_70"
            android:layout_gravity="center_horizontal"
            android:id="@+id/et_age_verification"
            android:background="@drawable/shape_stroke_review_body"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:minWidth="80dp"
            android:hint="YYYY"
            android:maxLines="1"
            android:maxLength="4"
            android:inputType="date"
            android:textCursorDrawable="@null"
            android:textAlignment="center"
            android:importantForAutofill="no"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/cross_cancel_download"
            android:gravity="center"
            android:id="@+id/tv_privacy_note_age_verification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:text="@string/age_verification_input_privacy_note"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l">
            <com.uptodown.core.view.UptodownTextView
                android:textColor="@color/accent_color"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_go_back_age_verification"
                android:background="@drawable/ripple_open_button"
                android:text="@string/go_back"
                app:coreTypefaceWeight="medium"
                style="@style/DialogButtonsStyle"/>
            <com.uptodown.core.view.UptodownTextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_continue_age_verification"
                android:text="@string/reminder_login_action"
                android:layout_marginStart="@dimen/margin_m"
                app:coreTypefaceWeight="medium"
                style="@style/DialogButtonsStyle"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
