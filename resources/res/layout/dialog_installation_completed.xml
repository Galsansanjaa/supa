<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_bg_dialog"
    android:paddingTop="@dimen/margin_l"
    android:paddingBottom="@dimen/margin_l"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/margin_l">
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_l"
        android:textColor="@color/text_primary"
        android:gravity="center_horizontal"
        android:id="@+id/tv_title_dialog_installation_completed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_m"
        android:layout_marginRight="@dimen/margin_m"
        android:text="@string/installation_completed"
        android:layout_marginHorizontal="@dimen/margin_m"
        app:coreTypefaceWeight="medium"/>
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_m"
        android:textColor="@color/text_primary"
        android:layout_gravity="center"
        android:id="@+id/tv_msg_dialog_installation_completed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_m"/>
    <com.uptodown.core.view.UptodownCheckBox
        android:textSize="@dimen/text_size_s"
        android:textColor="@color/text_primary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cb_dont_show_again_dialog_installation_completed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_m"
        android:layout_marginRight="@dimen/margin_m"
        android:text="@string/dont_show_again"
        android:buttonTint="@color/accent_color"
        android:layout_marginHorizontal="@dimen/margin_m"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_m"
        android:layout_marginTop="@dimen/margin_l"
        android:layout_marginRight="@dimen/margin_m"
        android:layout_marginHorizontal="@dimen/margin_m">
        <com.uptodown.core.view.UptodownTextView
            android:id="@+id/tv_ok_dialog_installation_completed"
            android:text="@string/ok"
            app:coreTypefaceWeight="medium"
            style="@style/DialogButtonsStyle"/>
        <com.uptodown.core.view.UptodownTextView
            android:id="@+id/tv_open_dialog_installation_completed"
            android:text="@string/open"
            android:layout_marginStart="@dimen/margin_m"
            app:coreTypefaceWeight="medium"
            style="@style/DialogButtonsStyle"/>
    </LinearLayout>
</LinearLayout>
