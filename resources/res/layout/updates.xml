<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.uptodown.views.UptodownAppBarLayout
        android:id="@+id/abl_toolbar_updates"
        android:background="@color/background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/UptodownToolbarTheme"
            android:id="@+id/toolbar_updates"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_scrollFlags="enterAlways|scroll"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight">
            <com.uptodown.core.view.UptodownTextView
                android:id="@+id/tv_toolbar_title_updates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/updates"
                app:coreTypefaceWeight="medium"
                style="@style/UptodownToolbarStyle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.uptodown.views.UptodownAppBarLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/srl_updates"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_updates"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/rl_bottom_box_shadow"
        android:background="@drawable/shape_bottom_download_button_gradient"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginBottom="50dp"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/rl_bottom_box_download_button_updates"
        android:background="@drawable/shape_bottom_download_button_bg"
        android:paddingTop="@dimen/margin_m"
        android:paddingBottom="@dimen/margin_m"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/margin_m">
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/white"
            android:id="@+id/tv_install_all_updates"
            android:background="@drawable/ripple_install_button"
            android:layout_width="match_parent"
            android:layout_marginLeft="@dimen/margin_m"
            android:layout_marginTop="@dimen/margin_s"
            android:layout_marginRight="@dimen/margin_m"
            android:layout_marginBottom="@dimen/margin_s"
            android:text="@string/update_all"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="@dimen/margin_m"
            android:layout_marginVertical="@dimen/margin_s"
            app:coreTypefaceWeight="medium"
            style="@style/AutoSizeTextView"/>
        <RelativeLayout
            android:id="@+id/rl_update_all_progress_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_m"
            android:layout_marginTop="@dimen/margin_s"
            android:layout_marginRight="@dimen/margin_m"
            android:layout_marginBottom="@dimen/margin_s"
            android:layout_marginHorizontal="@dimen/margin_m"
            android:layout_marginVertical="@dimen/margin_s">
            <com.uptodown.core.view.UptodownTextView
                android:textSize="12sp"
                android:textColor="@color/accent_color"
                android:id="@+id/tv_cancel_update_all"
                android:background="@drawable/ripple_open_button"
                android:layout_width="wrap_content"
                android:text="@string/dialog_update_all_button_cancel_all"
                app:coreTypefaceWeight="medium"
                style="@style/AutoSizeTextView"/>
            <android.widget.ProgressBar
                android:layout_gravity="center"
                android:id="@+id/pb_update_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_alignParentEnd="true"
                android:indeterminateTint="@color/accent_color"
                style="?android:attr/progressBarStyleSmall"/>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_m"
                android:textColor="@color/text_secundary"
                android:id="@+id/tv_description_update_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_m"
                android:layout_marginRight="@dimen/margin_m"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_cancel_update_all"
                android:layout_marginHorizontal="@dimen/margin_m"/>
        </RelativeLayout>
    </RelativeLayout>
    <include
        android:layout_gravity="center"
        android:id="@+id/loading_view_updates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/core_loading_view"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
