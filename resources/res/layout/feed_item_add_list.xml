<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="false">
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_m"
        android:textColor="@color/accent_color"
        android:ellipsize="end"
        android:id="@+id/tv_list_feed_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/recommendations_title"
        android:maxLines="1"
        android:lines="1"
        app:coreTypefaceWeight="medium"/>
    <RelativeLayout
        android:background="@drawable/shape_bg_feed_item_content"
        android:paddingTop="@dimen/margin_m"
        android:paddingBottom="@dimen/margin_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_list_feed_item"
        android:paddingVertical="@dimen/margin_m">
        <ImageView
            android:id="@+id/iv_icon_feed_item"
            android:layout_width="@dimen/icon_size_m"
            android:layout_height="@dimen/icon_size_m"
            android:layout_marginTop="@dimen/margin_s"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/margin_m"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:id="@+id/tv_app_name_feed_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_s"
            android:maxLines="1"
            android:lines="1"
            android:layout_marginStart="@dimen/margin_m"
            android:layout_marginEnd="@dimen/margin_s"
            android:layout_toStartOf="@+id/iv_options_feed_item"
            android:layout_toEndOf="@+id/iv_icon_feed_item"
            app:coreTypefaceWeight="medium"/>
        <ImageView
            android:id="@+id/iv_options_feed_item"
            android:background="@drawable/ripple_feed_item"
            android:padding="@dimen/margin_m"
            android:layout_width="@dimen/icon_size_m"
            android:layout_height="@dimen/icon_size_m"
            android:contentDescription="@null"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/vector_menu_dots_color_adaptable"/>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:id="@+id/tv_app_short_description_feed_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lines="1"
            android:layout_below="@+id/tv_app_name_feed_item"
            android:layout_marginStart="@dimen/margin_m"
            android:layout_marginEnd="@dimen/margin_s"
            android:layout_toStartOf="@+id/iv_options_feed_item"
            android:layout_toEndOf="@+id/iv_icon_feed_item"/>
    </RelativeLayout>
</RelativeLayout>
