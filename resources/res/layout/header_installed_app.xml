<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_logo_app"
        android:layout_width="@dimen/icon_size_m"
        android:layout_height="@dimen/icon_size_m"
        android:layout_marginTop="@dimen/margin_m"
        android:adjustViewBounds="true"
        android:layout_centerVertical="true"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/margin_m"
        app:srcCompat="@drawable/vector_uptodown_logo_disabled"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/iv_logo_app">
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_xl"
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lines="1"
            app:coreTypefaceWeight="medium"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_m"
                android:textColor="@color/accent_color"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_s"
                android:textColor="@color/white"
                android:id="@+id/tv_app_status"
                android:background="@drawable/shape_bg_accent_green"
                android:paddingLeft="@dimen/margin_m"
                android:paddingTop="2dp"
                android:paddingRight="@dimen/margin_m"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp"
                android:lines="1"
                android:textAllCaps="true"
                android:layout_marginStart="@dimen/margin_s"
                android:layout_marginVertical="1dp"
                android:paddingHorizontal="@dimen/margin_m"
                android:paddingVertical="2dp"/>
        </LinearLayout>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/text_secundary"
            android:ellipsize="end"
            android:id="@+id/tv_app_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
</RelativeLayout>
