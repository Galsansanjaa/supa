<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_bg_dialog"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.uptodown.core.view.UptodownTextView
        android:textSize="16sp"
        android:textColor="@color/accent_color"
        android:ellipsize="end"
        android:id="@+id/tv_dialog_accept_title"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:maxLines="1"
        android:paddingHorizontal="24dp"
        app:coreTypefaceWeight="medium"/>
    <com.uptodown.core.view.UptodownTextView
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:id="@+id/tv_dialog_accept_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:coreTypefaceWeight="regular"/>
    <com.uptodown.core.view.UptodownTextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_accept_option"
        android:focusable="true"
        android:clickable="true"
        android:layout_marginTop="@dimen/margin_m"
        android:layout_marginBottom="@dimen/margin_m"
        android:text="@string/ok"
        android:layout_marginVertical="@dimen/margin_m"
        app:coreTypefaceWeight="medium"
        style="@style/DialogButtonsStyle"/>
</LinearLayout>
