<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.uptodown.views.UptodownAppBarLayout
        android:id="@+id/abl_toolbar_search"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <include
            android:id="@+id/include_search_bar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            layout="@layout/search_bar"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_sections_search_activity"
            android:background="@drawable/core_shape_bg_light_grey"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_m"
            android:layout_marginRight="@dimen/margin_m"
            android:layout_marginHorizontal="@dimen/margin_m"
            app:layout_scrollFlags="enterAlways|scroll">
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_s"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_apps_search_activity"
                android:background="@drawable/core_ripple_button_accent_color"
                android:padding="@dimen/margin_m"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/apps"
                android:maxLines="1"
                android:layout_weight="1"
                android:textAllCaps="true"
                android:layout_marginEnd="@dimen/margin_s"
                app:coreTypefaceWeight="medium"/>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_s"
                android:textColor="@color/text_secundary"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_categories_search_activity"
                android:padding="@dimen/margin_m"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/categories"
                android:maxLines="1"
                android:layout_weight="1"
                android:textAllCaps="true"
                android:layout_marginStart="@dimen/margin_s"
                app:coreTypefaceWeight="medium"/>
        </LinearLayout>
    </com.uptodown.views.UptodownAppBarLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_activity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.uptodown.core.view.UptodownTextView
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_msg_search_activity"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_l"
        android:text="@string/no_results"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/loading_view_search"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/core_loading_view"/>
    <FrameLayout
        android:id="@+id/fl_category_search_activity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
