<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.uptodown.views.UptodownAppBarLayout
        android:id="@+id/abl_toolbar_avatar_activity"
        android:background="@color/background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/UptodownToolbarTheme"
            android:id="@+id/toolbar_avatar_activity"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_scrollFlags="enterAlways|scroll"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight">
            <com.uptodown.core.view.UptodownTextView
                android:id="@+id/tv_toolbar_title_avatar_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/avatar_activity_toolbar_title"
                app:coreTypefaceWeight="medium"
                style="@style/UptodownToolbarStyle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.uptodown.views.UptodownAppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_l"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_title_avatar_activity"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_m"
                android:layout_marginTop="@dimen/margin_m"
                android:layout_marginRight="@dimen/margin_m"
                android:layout_marginBottom="@dimen/margin_m"
                android:text="@string/avatar_activity_title"
                android:maxLines="1"
                android:layout_marginHorizontal="@dimen/margin_m"
                android:layout_marginVertical="@dimen/margin_m"
                app:coreTypefaceWeight="medium"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_turbo_separator_avatar_activity"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_l"
                android:layout_below="@+id/tv_title_avatar_activity">
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_l"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_turbo_avatar_title_avatar_activity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin_m"
                    android:layout_marginRight="@dimen/margin_m"
                    android:text="@string/turbo_avatars"
                    android:maxLines="1"
                    android:layout_marginHorizontal="@dimen/margin_m"
                    app:coreTypefaceWeight="medium"/>
                <ImageView
                    android:id="@+id/iv_turbo_avatar_title_avatar_activity"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/vector_turbo"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_turbo_avatar_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m"
                android:layout_below="@+id/ll_turbo_separator_avatar_activity"
                android:nestedScrollingEnabled="false"/>
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_l"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_avatars_title_avatar_activity"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_m"
                android:layout_marginTop="@dimen/margin_l"
                android:layout_marginRight="@dimen/margin_m"
                android:text="@string/avatars"
                android:maxLines="1"
                android:layout_below="@+id/rv_turbo_avatar_activity"
                android:layout_marginHorizontal="@dimen/margin_m"
                app:coreTypefaceWeight="medium"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_avatar_activity"
                android:paddingBottom="100dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_avatars_title_avatar_activity"
                android:nestedScrollingEnabled="false"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/shape_shadow_user_avatar_activity"
        android:layout_width="match_parent"
        android:layout_height="130dp"/>
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_l"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tv_save_avatar_activity"
        android:background="@drawable/core_ripple_button_accent_color"
        android:paddingTop="@dimen/margin_m"
        android:paddingBottom="@dimen/margin_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_l"
        android:layout_marginTop="@dimen/margin_m"
        android:layout_marginRight="@dimen/margin_l"
        android:layout_marginBottom="@dimen/margin_l"
        android:text="@string/save"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/margin_l"
        android:paddingVertical="@dimen/margin_m"
        app:coreTypefaceWeight="medium"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/loading_view_avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/core_loading_view"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
