<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/abl_toolbar_top_by_cat"
        android:background="@color/background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/UptodownToolbarTheme"
            android:id="@+id/toolbar_top_by_cat"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_scrollFlags="enterAlways|scroll"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.uptodown.core.view.UptodownTextView
                    android:id="@+id/tv_toolbar_title_top_by_cat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/ll_cat_actions"
                    app:coreTypefaceWeight="medium"
                    style="@style/UptodownToolbarStyle"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_cat_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:id="@+id/iv_share_top_by_cat"
                        android:visibility="gone"
                        android:layout_width="@dimen/icon_size_s"
                        android:layout_height="@dimen/icon_size_s"
                        android:layout_marginLeft="@dimen/margin_m"
                        android:layout_marginRight="@dimen/margin_m"
                        android:contentDescription="@string/option_button_share"
                        android:layout_marginHorizontal="@dimen/margin_m"
                        app:srcCompat="@drawable/core_vector_share"/>
                    <ImageView
                        android:id="@+id/iv_fav_top_by_cat"
                        android:visibility="gone"
                        android:layout_width="@dimen/icon_size_s"
                        android:layout_height="@dimen/icon_size_s"
                        android:layout_marginLeft="@dimen/margin_m"
                        android:layout_marginRight="@dimen/margin_m"
                        android:contentDescription="@null"
                        android:layout_marginHorizontal="@dimen/margin_m"
                        app:srcCompat="@drawable/vector_favorite_add"/>
                </LinearLayout>
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview_top_cat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/rl_no_data_top_cat"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <com.uptodown.core.view.UptodownTextView
            android:textColor="@color/text_secundary"
            android:gravity="center"
            android:id="@+id/tv_no_data_top_cat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_l"
            android:layout_marginRight="@dimen/margin_l"
            android:text="@string/data_loading_error"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="@dimen/margin_l"/>
        <com.uptodown.core.view.UptodownTextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_reload_top_by_category_fragment"
            android:background="@drawable/core_ripple_button_accent_color"
            android:padding="@dimen/margin_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:text="@string/refresh_enc"
            android:maxLines="1"
            android:layout_below="@+id/tv_no_data_top_cat"
            android:layout_centerHorizontal="true"
            android:textAllCaps="true"
            app:coreTypefaceWeight="medium"/>
    </RelativeLayout>
    <include
        android:layout_gravity="center"
        android:id="@+id/loading_view_top_by_cat_fragment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/core_loading_view"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
