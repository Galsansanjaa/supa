<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.uptodown.views.UptodownAppBarLayout
        android:id="@+id/abl_toolbar_lists"
        android:background="@color/background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/UptodownToolbarTheme"
            android:id="@+id/toolbar_lists"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_scrollFlags="enterAlways|scroll"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight">
            <com.uptodown.core.view.UptodownTextView
                android:id="@+id/tv_title_lists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lists_title"
                app:coreTypefaceWeight="medium"
                style="@style/UptodownToolbarStyle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.uptodown.views.UptodownAppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_lists"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/ll_wishlist_lists"
                android:visibility="visible"
                layout="@layout/lists_item"/>
            <include
                android:id="@+id/ll_recommended_lists"
                android:visibility="visible"
                layout="@layout/lists_item"/>
            <include
                android:id="@+id/ll_preregistrations_lists"
                android:visibility="visible"
                layout="@layout/lists_item"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_floating_categories_lists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_m"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/fl_lists"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/loading_view_lists"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/core_loading_view"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
