<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_app_info_top_by_cat_small_item"
    android:background="@drawable/core_ripple_bg_card"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_logo_app_info_top_by_cat_small_item"
        android:layout_width="@dimen/icon_size_l"
        android:layout_height="@dimen/icon_size_l"
        android:layout_marginTop="@dimen/margin_s"
        android:layout_marginBottom="@dimen/margin_s"
        android:layout_centerVertical="true"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/margin_m"
        android:layout_marginVertical="@dimen/margin_s"
        app:srcCompat="@drawable/vector_uptodown_logo_disabled"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="@dimen/margin_m"
        android:layout_toEndOf="@+id/iv_logo_app_info_top_by_cat_small_item">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.uptodown.core.view.UptodownTextView
                android:textSize="@dimen/text_size_l"
                android:textColor="@color/accent_color"
                android:id="@+id/tv_number_app_info_top_by_cat_small_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_s"
                app:coreTypefaceWeight="medium"/>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/iv_alternative_compare"
                android:layout_toEndOf="@+id/tv_number_app_info_top_by_cat_small_item">
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_l"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_name_app_info_top_by_cat_small_item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lines="1"
                    app:coreTypefaceWeight="medium"/>
                <ImageView
                    android:id="@+id/iv_badge_open_source"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/open_source"
                    android:layout_marginStart="@dimen/margin_s"
                    android:layout_toEndOf="@+id/tv_name_app_info_top_by_cat_small_item"
                    app:srcCompat="@drawable/vector_open_source"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/iv_alternative_compare"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/content_description_compare"
                android:layout_alignParentEnd="true"
                app:srcCompat="@drawable/vector_compare"/>
        </RelativeLayout>
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/text_secundary"
            android:ellipsize="end"
            android:id="@+id/tv_desc_app_info_top_by_cat_small_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lines="1"/>
        <com.uptodown.core.view.UptodownTextView
            android:id="@+id/tv_status_app_info_top_by_cat_small_item"
            android:visibility="gone"
            style="@style/TextViewAppInfoStatus"/>
    </LinearLayout>
</RelativeLayout>
