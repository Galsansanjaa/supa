<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_bg_instaler_activity"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp">
    <com.uptodown.core.view.UptodownTextView
        android:textSize="@dimen/text_size_m"
        android:textColor="@color/text_secundary"
        android:gravity="center"
        android:id="@+id/tv_confirm_delete_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:coreTypefaceWeight="regular"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_l">
        <com.uptodown.core.view.UptodownTextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_cancel_confirm_delete"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/option_button_cancel"
            app:coreTypefaceWeight="regular"
            style="@style/DialogButtonsStyle"/>
        <com.uptodown.core.view.UptodownTextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_delete_confirm_delete"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/option_button_delete"
            android:layout_marginStart="@dimen/margin_l"
            app:coreTypefaceWeight="regular"
            style="@style/DialogButtonsStyle"/>
    </LinearLayout>
</LinearLayout>
