<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.uptodown.views.UptodownAppBarLayout
        android:id="@+id/abl_toolbar_permissions"
        android:background="@color/background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/UptodownToolbarTheme"
            android:id="@+id/toolbar_permissions"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_scrollFlags="enterAlways|scroll"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight">
            <com.uptodown.core.view.UptodownTextView
                android:id="@+id/tv_title_permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/more_info_permissions"
                app:coreTypefaceWeight="medium"
                style="@style/UptodownToolbarStyle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.uptodown.views.UptodownAppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_permissions"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/margin_l"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_permissions_header_title"
                android:background="@drawable/core_shape_bg_light_grey"
                android:paddingLeft="@dimen/margin_m"
                android:paddingTop="@dimen/margin_s"
                android:paddingRight="@dimen/margin_m"
                android:paddingBottom="@dimen/margin_s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_m"
                android:layout_marginTop="@dimen/margin_m"
                android:layout_marginRight="@dimen/margin_m"
                android:layout_marginHorizontal="@dimen/margin_m"
                android:paddingHorizontal="@dimen/margin_m"
                android:paddingVertical="@dimen/margin_s">
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/v_circle"
                    android:background="@drawable/shape_circular_grey"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="@dimen/margin_m"/>
                <com.uptodown.core.view.UptodownTextView
                    android:textSize="@dimen/text_size_m"
                    android:textColor="@color/text_primary"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_total_permissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_permissions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_error_permissions"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_m"
        android:layout_marginRight="@dimen/margin_m"
        android:layout_marginHorizontal="@dimen/margin_m">
        <com.uptodown.core.view.UptodownTextView
            android:textSize="@dimen/text_size_xl"
            android:textColor="@color/text_secundary"
            android:gravity="center"
            android:id="@+id/tv_error_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_l"
            android:layout_marginRight="@dimen/margin_l"
            android:text="@string/data_loading_error"
            android:layout_marginHorizontal="@dimen/margin_l"/>
        <com.uptodown.core.view.UptodownTextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_reload_permissions"
            android:background="@drawable/core_ripple_button_accent_color"
            android:padding="@dimen/margin_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:text="@string/refresh_enc"
            android:maxLines="1"
            android:textAllCaps="true"
            app:coreTypefaceWeight="medium"/>
    </LinearLayout>
    <include
        android:layout_gravity="center"
        android:id="@+id/loading_view_permissions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/core_loading_view"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
