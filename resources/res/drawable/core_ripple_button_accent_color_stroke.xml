<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/accent_color_pressed">
    <item android:id="@android:id/background">
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_color_pressed"/>
                    <stroke
                        android:width="1dp"
                        android:color="@color/accent_color"/>
                    <corners android:radius="@dimen/border_radius_m"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1dp"
                        android:color="@color/accent_color"/>
                    <corners android:radius="@dimen/border_radius_m"/>
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/black"/>
            <corners android:radius="@dimen/border_radius_m"/>
        </shape>
    </item>
</ripple>
